<style>
    .alt-costume-chip-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .alt-costume-preview-wrap {
        width: 100%;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .alt-costume-preview {
        max-height: 120px;
        max-width: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        object-position: center;
        display: block;
        margin: 0 auto;
    }

    .alt-costume-label {
        font-size: 0.75rem;
        text-align: center;
        margin-top: 4px;
        line-height: 1.2;
        width: 100%;
    }
</style>

<div class="alt-costume-chip-content">
    <div class="alt-costume-preview-wrap">
        @* Both variants are rendered up-front so they are fetched together with the rest of the
           costume resources. Toggling UseCutin only flips CSS visibility - it never re-requests. *@
        <img src="@ImageSrc" class="alt-costume-preview" alt="@Label"
             style="@(UseCutin && HasCutin ? "display:none;" : string.Empty)"/>
        @if (HasCutin)
        {
            <img src="@CutinImageSrc" class="alt-costume-preview" alt="@Label"
                 style="@(UseCutin ? string.Empty : "display:none;")"/>
        }
    </div>
    <MudText Typo="Typo.caption" Class="alt-costume-label">@Label</MudText>
</div>

@code {
    [Parameter]
    public string ImageSrc { get; set; } = string.Empty;

    /// <summary>Cut-in variant of the preview image. When empty, only the normal image is shown.</summary>
    [Parameter]
    public string CutinImageSrc { get; set; } = string.Empty;

    /// <summary>When true, show the cut-in variant instead of the normal image (display only).</summary>
    [Parameter]
    public bool UseCutin { get; set; } = false;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    private bool HasCutin => !string.IsNullOrEmpty(CutinImageSrc);
}
