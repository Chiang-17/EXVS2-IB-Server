@using WebUIInfinite.Shared.Dto.Common
@using WebUIInfinite.Shared.Dto.Enum
@using WebUIInfinite.Client.Validator
@using WebUIInfinite.Client.Constants
@using WebUIInfinite.Client.Pages.Dialogs
@using WebUIInfinite.Client.Services.Common
@using WebUIInfinite.Client.Services.Name
@inherits BasicCustomizeComponent

@inject HttpClient Http
@inject ILogger<CustomizeCard> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject INameValidator NameValidator
@inject ICommonDataService CommonDataService
@inject INameService NameService

<style>
    .lock-on-marker-options .mud-chip-content {
        width: 100%;
    }

    .lock-on-marker-options .alt-costume-preview-wrap {
        height: auto;
    }

    .lock-on-marker-options .alt-costume-preview {
        width: 100%;
        max-height: none;
    }
</style>

<MudGrid xs="12">
    <MudItem xs="12">
        <MudCard Class="my-2" Elevation="5">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@localizer["generalcardinfo"]</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudStack Row>
                        <MudProgressCircular @bind-Class="@ProgressContext.HideProfileProgress" Color="Color.Default" Indeterminate="true" />
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Variant="Variant.Filled" OnClick="@SaveTask"
                                       Color="Color.Primary" Size="Size.Large" aria-label="save"></MudIconButton>
                    </MudStack>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudItem xs="12">
                        <MudForm>
                            <MudTextField @bind-Value="CustomizeCardContext.BasicProfile.UserName"
                                          Immediate="true"
                                          Variant="Variant.Outlined"
                                          Label="@localizer["playername"]"
                                          Validation="NameValidator.ValidatePlayerName" />
                        </MudForm>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudGrid Class="align-center">
                            <MudItem xs="6" Class="my-auto mud-typography mud-typography-body1">
                                @localizer["playerleveldisplay"]
                            </MudItem>
                            <MudItem xs="6" Class="my-auto d-flex justify-end">
                                <MudSwitch @bind-Value="OpenPlayerLevelDisplay" Color="Color.Primary"
                                           Label=""
                                           LabelPlacement="Placement.Start"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <WebUIInfinite.Client.Pages.Components.Customize.Inner.PlayerLevelComponent
                            CustomizeCardContext="@CustomizeCardContext"
                            EnableImagePreview="@EnableImagePreview"
                            OnChanged="@(() => StateHasChanged())" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.body1" Class="mb-2">@localizer["marker_color"]</MudText>
                        <MudCard Outlined="true" Class="my-2" Elevation="5">
                            <MudCardContent>
                                <MudChipSet T="int" @bind-SelectedValue="CustomizeCardContext.BasicProfile.MarkerColorId"
                                            SelectionMode="SelectionMode.SingleSelection" Class="lock-on-marker-options" Style="width: 100%;">
                                    <MudGrid Spacing="2" Style="width: 100%; margin: 0;">
                                        @foreach (var marker in CommonDataService.GetLockOnMarkers())
                                        {
                                            <MudItem xs="3" @key="marker.Id">
                                                <MudChip T="int" Variant="Variant.Text" Color="Color.Primary" Value="@(checked((int)marker.Id))"
                                                         Style="width: 100%; min-height: 150px; height: auto;">
                                                    <WebUIInfinite.Client.Pages.Components.Customize.Inner.AlternativeCostumeChipContent
                                                        ImageSrc="@($"images/lock_on_markers/{marker.Id}.webp")"
                                                        Label="@NameService.GetLocalizedName(marker)"/>
                                                </MudChip>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudChipSet>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="6" Class="my-auto mud-typography mud-typography-body1">
                                @localizer["is_fixed_radar_angle"]
                            </MudItem>
                            <MudItem xs="6" Class="my-auto">
                                <MudSwitch @bind-Value="@CustomizeCardContext.BasicProfile.IsFixedRadar" Color="Color.Primary"
                                           Label=""
                                           LabelPlacement="Placement.Start"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="6" Class="my-auto mud-typography mud-typography-body1">
                                @localizer["enable_quick_start"]
                            </MudItem>
                            <MudItem xs="6" Class="my-auto">
                                <MudSwitch @bind-Value="@CustomizeCardContext.BasicProfile.EnableQuickStart" Color="Color.Primary"
                                           Label=""
                                           LabelPlacement="Placement.Start"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    
                    @* Game Commentary Mode toggle (CustomizeGroup tag 5). *@
                    <MudItem xs="12">
                        <MudPaper Class="pa-4 my-2" Elevation="2">
                            <MudGrid Class="align-center">
                                <MudItem xs="8" sm="9" Class="my-auto">
                                    <MudText Typo="Typo.subtitle1">@localizer["bgm_safe_mode"]</MudText>
                                </MudItem>
                                <MudItem xs="4" sm="3" Class="my-auto d-flex justify-end">
                                    <MudSwitch @bind-Value="@CustomizeCardContext.BasicProfile.BgmSafeMode" Color="Color.Primary"
                                               Label=""
                                               LabelPlacement="Placement.Start"/>
                                </MudItem>
                            </MudGrid>

                            @if (!CustomizeCardContext.BasicProfile.BgmSafeMode)
                            {
                                <MudDivider Class="my-3"/>
                                <MudSelect @bind-Value="CustomizeCardContext.BasicProfile.DefaultBgmPlayingMethod" T="BgmPlayingMethod"
                                           Label="@localizer["bgmplaytype"]" Variant="Variant.Outlined" ToStringFunc="@converter">
                                    @foreach (var item in Enum.GetValues<BgmPlayingMethod>())
                                    {
                                        <MudSelectItem Value="@(item)" />
                                    }
                                </MudSelect>

                                <MudGrid Class="align-center mt-3">
                                    <MudItem xs="10" sm="11">
                                        <MudExpansionPanels>
                                            <MudExpansionPanel Text="@localizer["bgmlistorder"]">
                                                <MudSimpleTable Style="overflow-x: auto;">
                                                    <tbody>
                                                    @if(CustomizeCardContext.BasicProfile.DefaultBgmList.Any())
                                                    {
                                                        foreach (var x in CustomizeCardContext.BasicProfile.DefaultBgmList)
                                                        {
                                                            <tr>
                                                                <td>@(NameService.GetLocalizedName(CommonDataService.GetBgmById(x)) ?? $"Custom ID: {x}")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        CustomizeCardContext.BasicProfile.DefaultBgmList = Array.Empty<uint>();
                                                        <tr>
                                                            <td>No Entries</td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </MudSimpleTable>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    </MudItem>
                                    <MudItem xs="2" sm="1">
                                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" aria-label="edit"
                                                       OnClick="() => OpenProfileChangeBgmOrderDialog()" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudPaper>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <WebUIInfinite.Client.Pages.Components.Customize.Inner.GaugeComponent
                            Type="Basic"
                            BasicProfile="@CustomizeCardContext.BasicProfile"
                            DisplayLabel="@localizer["gauge"]"
                            EnableImagePreview="@EnableImagePreview" />
                    </MudItem>
                    
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="@localizer["main_title"]">
                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.TitleComponent
                                Title="@CustomizeCardContext.BasicProfile.DefaultTitle"
                                EnableImagePreview="@EnableImagePreview"
                                TitleOnly="true" />

                        </MudExpansionPanel>
                        <MudExpansionPanel Text="@localizer["sub_title_1"]">
                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.TitleComponent
                                Title="@SubTitle1"
                                EnableImagePreview="@EnableImagePreview"
                                TitleOnly="true" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="@localizer["sub_title_2"]">
                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.TitleComponent
                                Title="@SubTitle2"
                                EnableImagePreview="@EnableImagePreview"
                                TitleOnly="true" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    @* Legacy server-only: stage_randoms (LoadCard CustomizeGroup tag 50). Client does not read. *@
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code{
    [Parameter]
    public bool EnableImagePreview { get; set; } = false;
    
    Func<BgmPlayingMethod, string> converter = p => p.ToString();

    private Title SubTitle1 => CustomizeCardContext.BasicProfile.SubTitle1 ??= new();
    private Title SubTitle2 => CustomizeCardContext.BasicProfile.SubTitle2 ??= new();

    private async Task OpenProfileChangeBgmOrderDialog()
    {
        var parameters = new DialogParameters { { "Data", CustomizeCardContext.BasicProfile.DefaultBgmList } };
        var dialog = await DialogService.ShowAsync<ChangeBgmOrderDialog>(localizer["dialogtitle_bgmorder"], parameters, OPTIONS);
        var result = await dialog.Result;
    
        if (!result.Canceled)
        {
            CustomizeCardContext.BasicProfile.DefaultBgmList = (result.Data as uint[])!;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Maps <see cref="BasicProfile.OpenEchelon"/> to PreLoadCard <c>open_player_level</c> (bool):
    /// 1 = on/true, 0 = off/false. Field name kept for DB compatibility.
    /// </summary>
    private bool OpenPlayerLevelDisplay
    {
        get => CustomizeCardContext.BasicProfile.OpenEchelon != 0;
        set => CustomizeCardContext.BasicProfile.OpenEchelon = value ? 1u : 0u;
    }
}
