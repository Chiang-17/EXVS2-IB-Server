@inject ICommonDataService CommonDataService
@inject ILogger<ChangeBgmOrderDialog> Logger
@inject ISnackbar Snackbar
@using WebUIInfinite.Client.Services.Common
@using WebUIInfinite.Shared.Dto.Common;

<style>
    /* Order list is fixed-height so the swap slide distance is predictable. */
    .bgm-order-item {
        --bgm-slot-h: 56px;
        height: 48px;
        box-sizing: border-box;
    }

    /* After a swap, the item that ends up lower starts one slot above and slides down. */
    .bgm-anim-from-top {
        animation: bgm-slide-from-top 0.25s ease;
    }

    /* The item that ends up higher starts one slot below and slides up. */
    .bgm-anim-from-bottom {
        animation: bgm-slide-from-bottom 0.25s ease;
    }

    @@keyframes bgm-slide-from-top {
        from { transform: translateY(calc(-1 * var(--bgm-slot-h))); }
        to { transform: translateY(0); }
    }

    @@keyframes bgm-slide-from-bottom {
        from { transform: translateY(var(--bgm-slot-h)); }
        to { transform: translateY(0); }
    }
</style>

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="8">
                <MudTable Elevation="5" Items="@bgmList" Filter="@Filter" @ref="mudTable"
                          T="Bgm" Hover="true" FixedHeader="true">
                    <ColGroup>
                        <col style="width: 50px;"/>
                        <col/>
                        <col/>
                        <col style="width: 60px;"/>
                    </ColGroup>
                    <ToolBarContent>
                        <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="false"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                        </MudTextField>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<Bgm, object>(x => x.Id))">
                                Id
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(SortByBgmName())">
                                @localizer["bgm_dialog_name"]
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(SortBySeries())">
                                @localizer["bgm_dialog_series"]
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh/>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            #pragma warning disable CS8602
                        }
                        @{
                            var lang = Thread.CurrentThread.CurrentCulture.Name;
                        }
                        <MudTd DataLabel="Id">@context.Id</MudTd>
                        @{
                            var bgmName = context.Value;
        
                            if (lang == "ja")
                            {
                                bgmName = context.ValueJP;
                            }
        
                            if (lang == "zh-Hans")
                            {
                                bgmName = context.ValueCN;
                            }
                            
                            if (lang == "zh-Hant")
                            {
                                bgmName = context.ValueTC;
                            }
                            
                            if (lang == "zh-Hant-TW")
                            {
                                bgmName = context.ValueTC2;
                            }
                        }
                        <MudTd DataLabel="@localizer["bgm_dialog_name"]">@bgmName</MudTd>
                        @{
                            var series = context.Series;
        
                            if (lang == "ja")
                            {
                                series = context.SeriesJP;
                            }
        
                            if (lang == "zh-Hans")
                            {
                                series = context.SeriesCN;
                            }
                            
                            if (lang == "zh-Hant")
                            {
                                series = context.SeriesTC;
                            }
                            
                            if (lang == "zh-Hant-TW")
                            {
                                series = context.SeriesTC2;
                            }
                        }
                        <MudTd DataLabel="@localizer["bgm_dialog_series"]">@series</MudTd>
                        <MudTd Style="text-align:center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                           Variant="Variant.Filled" Color="Color.Primary"
                                           Style="border-radius:4px;"
                                           aria-label="add"
                                           Disabled="@IsAdded(context.Id)"
                                           OnClick="@(() => AddBgmById(context.Id))"/>
                        </MudTd>
                        @{
                            #pragma warning restore CS8602
                        }
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="@pageSizeOptions"/>
                    </PagerContent>
                </MudTable>
            </MudItem>

            <MudItem xs="4" Style="position: sticky; top: 8px; align-self: flex-start;">
                <MudPaper Elevation="5" Class="pa-2">
                    <MudText Typo="Typo.h6" Class="pa-2">Order</MudText>
                    @if (items.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-2 mud-text-secondary">—</MudText>
                    }
                    @for (var i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        var index = i;
                        var animClass = _animFromTop.Contains(item.Id)
                            ? "bgm-anim-from-top"
                            : _animFromBottom.Contains(item.Id)
                                ? "bgm-anim-from-bottom"
                                : string.Empty;
                        <MudPaper @key="item.Id" Outlined="true"
                                  Class="@($"bgm-order-item d-flex align-center justify-space-between pa-2 my-1 {animClass}")">
                            <MudText>@item.ValueJP</MudText>
                            <div class="d-flex">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Primary"
                                               aria-label="move up" Disabled="@(index == 0)"
                                               OnClick="@(() => MoveUp(item))"/>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Primary"
                                               aria-label="move down" Disabled="@(index == items.Count - 1)"
                                               OnClick="@(() => MoveDown(item))"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Error"
                                               aria-label="remove"
                                               OnClick="@(() => RemoveItem(item))"/>
                            </div>
                        </MudPaper>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    private MudTable<Bgm> mudTable = null!;

    private string searchString = string.Empty;

    private readonly int[] pageSizeOptions = { 10, 25, 50, 100 };

    [Parameter]
    public uint[] Data { get; set; } = null!;

    private IReadOnlyList<Bgm> bgmList = new List<Bgm>();

    private List<DropItem> items = new();

    // Legacy: add by uint ID input
    // private uint _bgmIdInput;

    // Legacy: test Custom ID
    // private uint _customBgmId;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        bgmList = CommonDataService.GetBgmSortedById();

        items = Data.Select(CreateDropItemFromId).ToList();
        // Legacy: _bgmIdInput = Data.FirstOrDefault();
    }

    private void Submit()
    {
        var selectedBgm = items.Select(x => x.Id).ToArray();

        Data = selectedBgm;
        
        MudDialog.Close(DialogResult.Ok(Data));
    }

    private void Cancel() => MudDialog.Cancel();

    private bool IsAdded(uint id) => items.Any(x => x.Id == id);

    private void AddBgmById(uint id) => TryAddToOrder(CreateDropItemFromId(id));

    private void RemoveItem(DropItem item)
    {
        items.Remove(item);
        StateHasChanged();
    }

    // Slide animation state: ids of items currently sliding into place.
    private readonly HashSet<uint> _animFromTop = new();
    private readonly HashSet<uint> _animFromBottom = new();
    private const int SwapAnimationMs = 250;
    private bool _isAnimating;

    private Task MoveUp(DropItem item)
    {
        var index = items.IndexOf(item);
        return index <= 0 ? Task.CompletedTask : AnimateSwapAsync(index - 1, index);
    }

    private Task MoveDown(DropItem item)
    {
        var index = items.IndexOf(item);
        return index < 0 || index >= items.Count - 1 ? Task.CompletedTask : AnimateSwapAsync(index, index + 1);
    }

    // Swaps two adjacent items (upper < lower) and plays a slide animation on both.
    private async Task AnimateSwapAsync(int upper, int lower)
    {
        if (_isAnimating)
        {
            return;
        }

        _isAnimating = true;

        (items[upper], items[lower]) = (items[lower], items[upper]);

        _animFromTop.Clear();
        _animFromBottom.Clear();
        // The item now at 'lower' came from above -> slide in from the top.
        _animFromTop.Add(items[lower].Id);
        // The item now at 'upper' came from below -> slide in from the bottom.
        _animFromBottom.Add(items[upper].Id);
        StateHasChanged();

        await Task.Delay(SwapAnimationMs);

        _animFromTop.Clear();
        _animFromBottom.Clear();
        _isAnimating = false;
        StateHasChanged();
    }

    // Legacy: add by uint ID input
    /*
    private void AddBgmFromInput()
    {
        TryAddToOrder(CreateDropItemFromId(_bgmIdInput));
    }

    private void AddCustomBgmId()
    {
        TryAddToOrder(CreateDropItemFromId(_customBgmId));
    }
    */

    private void TryAddToOrder(DropItem dropItem)
    {
        if (items.Count >= 6)
        {
            Snackbar.Add("Cannot add more than 6 Bgm(s)", Severity.Error);
            return;
        }

        if (items.Any(x => x.Id == dropItem.Id))
        {
            return;
        }

        items.Add(dropItem);
        StateHasChanged();
    }

    private DropItem CreateDropItemFromId(uint id)
    {
        var bgm = CommonDataService.GetBgmById(id);
        return new DropItem
        {
            Id = id,
            ValueJP = GetBgmDisplayName(bgm, id)
        };
    }

    private string GetBgmDisplayName(Bgm? bgm, uint id)
    {
        if (bgm is null)
        {
            return $"Custom ID: {id}";
        }

        var lang = Thread.CurrentThread.CurrentCulture.Name;

        if (lang == "en-US")
        {
            return bgm.Value;
        }

        if (lang == "zh-Hans")
        {
            return bgm.ValueCN;
        }

        if (lang == "zh-Hant")
        {
            return bgm.ValueTC;
        }

        if (lang == "zh-Hant-TW")
        {
            return bgm.ValueTC2;
        }

        return bgm.ValueJP;
    }

    private bool Filter(Bgm? bgm)
    {
        if (bgm is null)
        {
            return false;
        }
        var aggregate = $"{bgm.Value}{bgm.ValueJP}{bgm.ValueCN}{bgm.ValueTC}{bgm.ValueTC2}";
        return string.IsNullOrEmpty(searchString) ||
               aggregate.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }

    public class DropItem
    {
        public uint Id { get; init; }
        public string ValueJP { get; init; } = string.Empty;
    }
    
    private Func<Bgm, object> SortByBgmName()
    {
        if (Thread.CurrentThread.CurrentCulture.Name == "en-US")
        {
            return bgm => bgm.Value;
        }

        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hans")
        {
            return bgm => bgm.ValueCN;
        }
        
        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hant")
        {
            return bgm => bgm.ValueTC;
        }
        
        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hant-TW")
        {
            return bgm => bgm.ValueTC2;
        }

        return bgm => bgm.ValueJP;
    }

    private Func<Bgm, object> SortBySeries()
    {
        if (Thread.CurrentThread.CurrentCulture.Name == "en-US")
        {
            return bgm => bgm.Series;
        }

        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hans")
        {
            return bgm => bgm.SeriesCN;
        }
        
        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hant")
        {
            return bgm => bgm.SeriesTC;
        }
        
        if (Thread.CurrentThread.CurrentCulture.Name == "zh-Hant-TW")
        {
            return bgm => bgm.SeriesTC2;
        }

        return bgm => bgm.SeriesJP;
    }
}
